#!/usr/bin/env bash

tep_name="TEP_ACME"
coffe_name="CoffeData"
piade_prefix="piade_s"
piade_suffix="_alarms_no_zeros"
real_dataset_names=("$tep_name" "$coffe_name" "$piade_prefix")

contains() {
  local target="$1"
  shift
  for element in "$@"; do
    [[ "$element" == "$target" ]] && return 0
  done
  return 1
}

get_datapath() {

  local dataset_name=$1
  local -n out=$2
  out[tep_name]="$tep_name"
  out[coffe_name]="$coffe_name"
  out[piade_prefix]="$piade_prefix"
  out[piade_suffix]="$piade_suffix"

  if ! contains "$dataset_name" "${real_dataset_names[@]}"; then

    out[dataset_path]="../../datasets/data/syn/$dataset_name"

    if [[ ! -e "${out[dataset_path]}" ]]; then
      echo "No synthetic dataset at ${out[dataset_path]}"
      exit 1
    fi

  else

    case "$dataset_name" in

    "$tep_name")
      out[dataset_path]="../../datasets/data/$dataset_name"
      ;;

    ${piade_prefix}[1-5])
      out[dataset_path]="../../datasets/data/PIADE/$dataset_name"
      ;;

    ${piade_prefix}[1-5]${piade_suffix})
      out[dataset_path]="../../datasets/data/PIADE/$dataset_name"
      ;;

    "$coffe_name")
      out[dataset_path]="../../datasets/data/$dataset_name"
      ;;

    *)
      echo "Dataset name $dataset_name not supported." >&2
      echo "Supported names: TEP_ACME, piade_s[1-5], CoffeData" >&2
      return 1
      ;;
    esac

  fi
}
