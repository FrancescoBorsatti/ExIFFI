#!/usr/bin/env bash

script_path="ablation_max_samples.py"

dataset_name="${1:-'TEP_ACME'}"

source "./dataset_config"

declare -A cfg
get_datapath "$dataset_name" cfg

dataset_path=${cfg[dataset_path]}
tep_name=${cfg[tep_name]}
coffe_name=${cfg[coffe_name]}
piade_prefix=${cfg[piade_prefix]}
piade_suffix=${cfg[piade_suffix]}

model_name="EIF+"
interpretation="EXIFFI+"
scenario=2
n_runs=10
n_estimators=100
max_samples_values=(64 128 256 512 1024 2048)

echo "---------------------------------------------------"
echo "Running ablation max_samples experiment for $dataset_name"
echo "---------------------------------------------------"

uv run $script_path \
    --dataset_name "$dataset_name" \
    --dataset_path "$dataset_path" \
    --model_name "$model_name" \
    --interpretation "$interpretation" \
    --scenario "$scenario" \
    --seed 0 \
    --n_estimators "$n_estimators" \
    --max_samples_values "${max_samples_values[@]}" \
    --n_runs "$n_runs" \
    --pre_process \
    --scaler_type 4 \
    --run_ablation_max_samples \
    --plot_ablation_max_samples \
    --file_pos 0
