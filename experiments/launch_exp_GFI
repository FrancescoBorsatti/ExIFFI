#!/usr/bin/env bash

script_path="gfi_exp.py"

dataset_name="${1:-'TEP_ACME'}"

source "./dataset_config"

declare -A cfg
get_datapath "$dataset_name" cfg

dataset_path=${cfg[dataset_path]}
tep_name=${cfg[tep_name]}
coffe_name=${cfg[coffe_name]}
piade_prefix=${cfg[piade_prefix]}
smd_prefix=${cfg[smd_prefix]}
piade_suffix=${cfg[piade_suffix]}

model_name="$2"
interpretation="$3"
n_estimators=${4:-300}
scenario=${5:-2}
n_runs=${6:-40}
file_pos=${7:-0}
contamination=0.15

echo "#############################################"
echo "GFI experiment for model $model_name and interpretation $interpretation"
echo "#############################################"

if [[ "$dataset_name" == ${piade_prefix}[1-5] || "$dataset_name" == ${piade_prefix}[1-5]${piade_suffix} ]]; then

  echo "---------------------------------------------------"
  echo "Running GFI experiment for $dataset_name with contamination=$contamination"
  echo "---------------------------------------------------"

  uv run $script_path \
    --dataset_name "$dataset_name" \
    --dataset_path "$dataset_path" \
    --model_name "$model_name" \
    --interpretation "$interpretation" \
    --scenario "$scenario" \
    --seed 0 \
    --contamination $contamination \
    --n_estimators "$n_estimators" \
    --n_runs "$n_runs" \
    --pre_process \
    --scaler_type 4 \
    --compute_gfi \
    --score_plot \
    --file_pos "$file_pos"

elif [[ "$dataset_name" == "$tep_name" || "$dataset_name" == "$coffe_name" || "$dataset_name" == "${smd_prefix}"* ]]; then

  echo "---------------------------------------------------"
  echo "Running GFI experiment for $dataset_name with true dataset contamination"
  echo "---------------------------------------------------"

  uv run $script_path \
    --dataset_name "$dataset_name" \
    --dataset_path "$dataset_path" \
    --model_name "$model_name" \
    --interpretation "$interpretation" \
    --scenario "$scenario" \
    --seed 0 \
    --n_estimators "$n_estimators" \
    --n_runs "$n_runs" \
    --pre_process \
    --scaler_type 4 \
    --file_pos "$file_pos" \
    --compute_gfi \
    --score_plot

else

  echo "---------------------------------------------------"
  echo "Running GFI experiment for $dataset_name, synthetic dataset so no pre processing"
  echo "---------------------------------------------------"

  uv run $script_path \
    --dataset_name "$dataset_name" \
    --dataset_path "$dataset_path" \
    --model_name "$model_name" \
    --interpretation "$interpretation" \
    --scenario "$scenario" \
    --seed 0 \
    --n_estimators "$n_estimators" \
    --n_runs "$n_runs" \
    --file_pos "$file_pos" \
    --compute_gfi \
    --score_plot

fi
