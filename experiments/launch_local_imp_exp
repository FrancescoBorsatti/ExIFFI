#!/usr/bin/env bash

script_path="lfi_exp.py"

dataset_name="${1:-'TEP_ACME'}"

source "./dataset_config"

declare -A cfg
get_datapath "$dataset_name" cfg

dataset_path=${cfg[dataset_path]}
tep_name=${cfg[tep_name]}
coffe_name=${cfg[coffe_name]}
piade_prefix=${cfg[piade_prefix]}
piade_suffix=${cfg[piade_suffix]}
smd_prefix=${cfg[smd_prefix]}

model_name="$2"
interpretation="$3"
lfi_scatter_plot=${4:-0}
n_estimators=300
scenario=2
n_runs=40
file_pos=0
contamination=0.15

echo "#############################################"
echo "LFI experiment for model $model_name and interpretation $interpretation"
echo "#############################################"

if [[ "$dataset_name" == "$tep_name" || "$dataset_name" == "$coffe_name" || "$dataset_name" == "${smd_prefix}"* ]]; then

  uv run $script_path \
      --dataset_name "$dataset_name" \
      --dataset_path "$dataset_path" \
      --n_estimators "$n_estimators" \
      --model_name "$model_name" \
      --interpretation "$interpretation" \
      --scenario "$scenario" \
      --seed 0 \
      --n_runs "$n_runs" \
      --pre_process \
      --scaler_type 4 \
      --file_pos "$file_pos" \
      --compute_lfi \
      --score_plot

elif [[ "$dataset_name" == ${piade_prefix}[1-5] || "$dataset_name" == ${piade_prefix}[1-5]${piade_suffix} ]]; then

  uv run $script_path \
      --dataset_name "$dataset_name" \
      --dataset_path "$dataset_path" \
      --n_estimators "$n_estimators" \
      --model_name "$model_name" \
      --interpretation "$interpretation" \
      --scenario "$scenario" \
      --contamination "$contamination" \
      --n_runs "$n_runs" \
      --pre_process \
      --scaler_type 1 \
      --file_pos "$file_pos" \
      --compute_lfi \
      --score_plot
else

  echo "---------------------------------------------------"
  echo "Running LFI experiment for $dataset_name, synthetic dataset so no pre processing"
  echo "---------------------------------------------------"

  uv run $script_path \
      --dataset_name "$dataset_name" \
      --dataset_path "$dataset_path" \
      --n_estimators "$n_estimators" \
      --model_name "$model_name" \
      --interpretation "$interpretation" \
      --scenario "$scenario" \
      --contamination "$contamination" \
      --n_runs "$n_runs" \
      --file_pos "$file_pos" \
      --compute_lfi \
      --score_plot

fi

if [[ "$lfi_scatter_plot" != 0 ]]; then

  ./launch_lfi_scatter_plot \
    "$dataset_name" \
    "$model_name" \
    "$interpretation" \
    $n_estimators \
    $scenario \
    $file_pos

fi

