#!/usr/bin/env bash

script_path="metrics_exp.py"

dataset_name="${1:-'TEP_ACME'}"
compute_metrics="${2:-0}"

source "./dataset_config"

declare -A cfg
get_datapath "$dataset_name" cfg

dataset_path=${cfg[dataset_path]}
tep_name=${cfg[tep_name]}
coffe_name=${cfg[coffe_name]}
piade_prefix=${cfg[piade_prefix]}
smd_prefix=${cfg[smd_prefix]}

model_names=("SVDD")
interpretations=("ACME")
n_estimators=300
scenario=2
n_runs=10
n_runs_imp=10
background=0.25
seed=0
file_pos=0
mode="metrics"
contamination=0.15
epochs=10
batch_size=64
device_num=0

n_models=${#model_names[@]}

for ((i = 0; i < n_models; i++)); do

  if [[ "$compute_metrics" != 0 ]]; then

    echo "-----------------------------------------------------------------------------------------------------"
    echo "Performance metrics experiment for model ${model_names[$i]} and interpretation ${interpretations[$i]}"
    echo "-----------------------------------------------------------------------------------------------------"

    if [[ "$dataset_name" = ${piade_prefix}[1-5] && "$dataset_name" = ${piade_prefix}[1-5]${piade_suffix} ]]; then

      echo "-----------------------------------------------------------------------------------------------------"
      echo "dataset_name is $dataset_name, so we just perform the time experiments"
      echo "-----------------------------------------------------------------------------------------------------"

      mode="times"

      uv run $script_path \
        --dataset_name "$dataset_name" \
        --dataset_path "$dataset_path" \
        --model "${model_names[$i]}" \
        --interpretation "${interpretations[$i]}" \
        --n_estimators $n_estimators \
        --scenario $scenario \
        --pre_process \
        --compute_GFI \
        --contamination $contamination \
        --n_runs $n_runs \
        --n_runs_imp $n_runs_imp \
        --background $background \
        --seed $seed \
        --epochs $epochs \
        --batch_size $batch_size \
        --device_num $device_num \
        --file_pos $file_pos

    elif [[ "$dataset_name" == "$tep_name" || "$dataset_name" == "$coffe_name" || "$dataset_name" == "${smd_prefix}"* ]]; then

      echo "-----------------------------------------------------------------------------------------------------"
      echo "dataset_name is $dataset_name, so running metrics_exp with compute_perf with pre processing"
      echo "-----------------------------------------------------------------------------------------------------"

      mode="metrics"

      uv run $script_path \
        --dataset_name "$dataset_name" \
        --dataset_path "$dataset_path" \
        --model "${model_names[$i]}" \
        --interpretation "${interpretations[$i]}" \
        --n_estimators $n_estimators \
        --scenario $scenario \
        --pre_process \
        --scaler_type 4 \
        --compute_GFI \
        --contamination $contamination \
        --n_runs $n_runs \
        --n_runs_imp $n_runs_imp \
        --compute_perf \
        --background $background \
        --seed $seed \
        --epochs $epochs \
        --batch_size $batch_size \
        --device_num $device_num \
        --file_pos $file_pos

    else

      echo "-----------------------------------------------------------------------------------------------------"
      echo "dataset_name is $dataset_name, so running metrics_exp with compute_perf without pre processing (synthetic dataset)"
      echo "-----------------------------------------------------------------------------------------------------"

      mode="metrics"

      uv run $script_path \
        --dataset_name "$dataset_name" \
        --dataset_path "$dataset_path" \
        --model "${model_names[$i]}" \
        --interpretation "${interpretations[$i]}" \
        --n_estimators $n_estimators \
        --scenario $scenario \
        --compute_GFI \
        --contamination $contamination \
        --n_runs $n_runs \
        --n_runs_imp $n_runs_imp \
        --compute_perf \
        --background $background \
        --seed $seed \
        --epochs $epochs \
        --batch_size $batch_size \
        --device_num $device_num \
        --file_pos $file_pos

    fi

  fi

  echo "-----------------------------------------------------------------------------------------------------"
  echo "Getting results of metrics experiment"
  echo "-----------------------------------------------------------------------------------------------------"

  ./launch_get_metrics \
    "$dataset_name" \
    "$dataset_path" \
    "${model_names[$i]}" \
    "${interpretations[$i]}" \
    $n_estimators \
    $scenario \
    $file_pos \
    $mode

done
