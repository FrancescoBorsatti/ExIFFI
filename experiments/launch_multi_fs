#!/usr/bin/env bash

script_path="multi_fs_exp.py"

dataset_name="${1:-'TEP_ACME'}"

source "./dataset_config"

declare -A cfg
get_datapath "$dataset_name" cfg

dataset_path=${cfg[dataset_path]}
tep_name=${cfg[tep_name]}
coffe_name=${cfg[coffe_name]}
piade_prefix=${cfg[piade_prefix]}

model_names=("EIF+" "EIF+" "IF" "EIF+")
interpretations=("EXIFFI+" "ACME" "DIFFI" "KernelSHAP")
scenario=2
file_pos=0
change_box_loc=0.6
eval_model="EIF+"

uv run $script_path \
    --dataset_name "$dataset_name" \
    --dataset_path "$dataset_path" \
    --eval_model $eval_model \
    --model_interpretations "${model_names[@]}" \
    --interpretations "${interpretations[@]}" \
    --scenario $scenario \
    --scaler_type 4 \
    --pre_process \
    --change_box_loc $change_box_loc \
    --file_pos $file_pos \
    --rotation

