#!/usr/bin/env bash

script_path="sensor_interactions.py"

dataset_name="${1:-'TEP_ACME'}"

source "./dataset_config"

declare -A cfg
get_datapath "$dataset_name" cfg

dataset_path=${cfg[dataset_path]}

echo "----------------------------------------------------------------"
echo "Executing sensor interactions experiment for $dataset_name"
echo "dataset_path: $dataset_path"
echo "----------------------------------------------------------------"

uv run $script_path \
  --dataset_name "$dataset_name" \
  --dataset_path "$dataset_path"
