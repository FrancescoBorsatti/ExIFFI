#!/usr/bin/env bash

script_path="syn_data_test.py"

echo "------------------------------------------------"
echo "Executing $script_path"
echo "------------------------------------------------"

syn_data_name="${1:-Xaxis}"
n_inliers=900
n_outliers=100
anomaly_axis=0
anomaly_interval=(-1 1)
# anomaly_interval=(10 15)
v=(4 3 2 0 0 0)
n_dims=6
radius=2
moon_radius=35
axes=(0 1)

python $script_path \
  --syn_data_name "$syn_data_name" \
  --n_inliers $n_inliers \
  --n_outliers $n_outliers \
  --anomaly_axis $anomaly_axis \
  --anomaly_interval "${anomaly_interval[@]}" \
  --v "${v[@]}" \
  --n_dims $n_dims \
  --radius $radius \
  --moon_radius $moon_radius \
  --axes "${axes[@]}" \
  --plot_syn_data \
  --save_plot

